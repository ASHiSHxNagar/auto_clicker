<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/menuRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_floating_menu"
    android:elevation="8dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingTop="6dp"
    android:paddingEnd="8dp"
    android:paddingBottom="6dp">

    <!-- Drag Grip Handle -->
    <ImageView
        android:id="@+id/ivDragHandle"
        android:layout_width="28dp"
        android:layout_height="36dp"
        android:clickable="true"
        android:contentDescription="Drag Menu"
        android:focusable="false"
        android:padding="4dp"
        android:src="@drawable/ic_drag_handle" />

    <!-- Play / Pause Toggle Button -->
    <ImageButton
        android:id="@+id/btnPlayPause"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/bg_play_button"
        android:contentDescription="Play or Pause"
        android:padding="8dp"
        android:src="@drawable/ic_play" />

    <!-- Add Target Pin (+) -->
    <ImageButton
        android:id="@+id/btnAddPin"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/bg_menu_button"
        android:contentDescription="Add Target Pin"
        android:padding="8dp"
        android:src="@drawable/ic_add" />

    <!-- Remove Target Pin (-) -->
    <ImageButton
        android:id="@+id/btnRemovePin"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/bg_menu_button"
        android:contentDescription="Remove Target Pin"
        android:padding="8dp"
        android:src="@drawable/ic_remove" />

    <!-- Settings Gear -->
    <ImageButton
        android:id="@+id/btnSettings"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/bg_menu_button"
        android:contentDescription="Click Settings"
        android:padding="8dp"
        android:src="@drawable/ic_settings" />

    <!-- Close (X) -->
    <ImageButton
        android:id="@+id/btnClose"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/bg_menu_button"
        android:contentDescription="Close Overlay"
        android:padding="8dp"
        android:src="@drawable/ic_close" />

</LinearLayout>
